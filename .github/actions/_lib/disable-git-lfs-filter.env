# ``actions/checkout`` with ``lfs: true`` runs ``git lfs install --local``, which writes
# ``filter.lfs.required=true`` into the .git/config that CI bind-mounts into its test containers.
# The images ship no Git LFS, so every in-container git call on that tree (RSL-RL's code-state
# snapshot) would fail with "the remote end hung up unexpectedly". GIT_CONFIG_* outranks repository
# config. LFS files then read as modified, and ``diff.lfs.binary`` keeps their content out of diffs.
GIT_CONFIG_COUNT=5
GIT_CONFIG_KEY_0=filter.lfs.required
GIT_CONFIG_VALUE_0=false
GIT_CONFIG_KEY_1=filter.lfs.process
GIT_CONFIG_VALUE_1=
GIT_CONFIG_KEY_2=filter.lfs.clean
GIT_CONFIG_VALUE_2=
GIT_CONFIG_KEY_3=filter.lfs.smudge
GIT_CONFIG_VALUE_3=
GIT_CONFIG_KEY_4=diff.lfs.binary
GIT_CONFIG_VALUE_4=true
