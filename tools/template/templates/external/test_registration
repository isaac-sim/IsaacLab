"""Tests for the generated task registrations."""

import gymnasium as gym

import {{ name }}.tasks  # noqa: F401


def test_task_registrations():
    """The generated tasks must expose valid environment and agent entry points."""
    expected = {
{% for specification in specifications %}
        "{{ specification.task.id }}": {
            "entry_point": {% if specification.task.workflow.name == "direct" %}"{{ name }}.tasks.{{ specification.task.family_name }}.config.{{ robot_name }}.{{ specification.task.env_filename }}:{{ specification.task.classname }}Env"{% else %}"isaaclab.envs:ManagerBasedRLEnv"{% endif %},
            "env_cfg_entry_point": "{{ name }}.tasks.{{ specification.task.family_name }}.config.{{ robot_name }}.{{ specification.task.env_cfg_filename }}:{{ specification.task.classname }}EnvCfg",
{% if specification.rl_libraries | length == 1 %}
            "default_agent": "{{ specification.rl_libraries[0].name }}",
{% endif %}
        },
{% endfor %}
    }

    for task_id, expected_values in expected.items():
        spec = gym.spec(task_id)
        assert spec.entry_point == expected_values["entry_point"]
        assert spec.kwargs["env_cfg_entry_point"] == expected_values["env_cfg_entry_point"]
        if "default_agent" in expected_values:
            assert spec.kwargs["default_agent"] == expected_values["default_agent"]
