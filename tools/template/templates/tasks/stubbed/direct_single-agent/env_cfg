from dataclasses import MISSING

from isaaclab.assets import ArticulationCfg
from isaaclab.envs import DirectRLEnvCfg
from isaaclab.physics import PhysicsCfg
from isaaclab.scene import InteractiveSceneCfg
from isaaclab.sim import SimulationCfg
from isaaclab.utils import configclass

from isaaclab_tasks.utils import PresetCfg


@configclass
class {{ task.classname }}PhysicsCfg(PresetCfg):
    """Select and configure physics for your task."""

    default: PhysicsCfg = MISSING


@configclass
class {{ task.classname }}SceneCfg(InteractiveSceneCfg):
    """Define robot assets, ground, lighting, and other scene objects."""

    robot: ArticulationCfg = MISSING


@configclass
class {{ task.classname }}EnvCfg(DirectRLEnvCfg):
    """Configure the task before constructing the environment."""

    decimation: int = MISSING
    episode_length_s: float = MISSING
    action_space: int = MISSING
    observation_space: int = MISSING
    state_space: int = MISSING
{% if task.amp_selected %}
    num_amp_observations: int = MISSING
    amp_observation_space: int = MISSING
{% endif %}

    sim: SimulationCfg = SimulationCfg(physics={{ task.classname }}PhysicsCfg())
    scene: {{ task.classname }}SceneCfg = {{ task.classname }}SceneCfg(num_envs=1, env_spacing=4.0)

    def __post_init__(self) -> None:
        """Set simulation timing, physics, spaces, and task parameters."""
        raise NotImplementedError("Configure simulation, scene, and task parameters.")
