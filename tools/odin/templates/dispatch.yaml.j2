workflow:
  name: odin-{{ dispatch_id }}-{{ chunk_index }}
  timeout:
    exec_timeout: {{ cfg.exec_timeout_s }}s
    queue_timeout: {{ cfg.queue_timeout_s }}s
  resources:
    default:
      cpu: {{ cfg.resources.cpu }}
      gpu: {{ cfg.resources.gpu }}
      memory: {{ cfg.resources.memory }}
      storage: {{ cfg.resources.storage }}
      platform: {{ cfg.resources.platform }}
  # Every task is wrapped in its own single-task group. OSMO's workflow-level
  # exec_timeout clock starts at each group's transition to RUNNING, so with
  # tasks at the workflow root a late-scheduled task would be killed for other
  # tasks' queue time.
  groups:
{% for row in rows %}
  - name: g-{{ row.osmo_task_name }}
    tasks:
    - name: {{ row.osmo_task_name }}
      image: {{ image_ref }}
{% if cfg.image.pull_credential %}
      # OSMO maps a credential name to the registry host it authenticates.
      credentials:
        {{ cfg.image.pull_credential }}: {{ cfg.image.registry_host }}
{% endif %}
      environment:
        # Kit's bootstrap reads OMNI_KIT_ACCEPT_EULA; without it it prompts on
        # stdin, which is closed here, and dies with "Unable to bootstrap inner
        # kit kernel: EOF when reading a line". ACCEPT_EULA covers the Isaac Sim
        # layer. Both are set by .github/actions/run-tests.
        OMNI_KIT_ACCEPT_EULA: "yes"
        ACCEPT_EULA: "Y"
        OMNI_KIT_ALLOW_ROOT: "1"
        # The CUDA base image defaults to compute,utility, which omits the GL
        # driver libraries. Newton's headless video recorder loads libGL through
        # pyglet, so without graphics the play step dies on `Library "GL" not
        # found` -- reported as "requires pyglet to be installed", though pyglet
        # itself is present.
        NVIDIA_DRIVER_CAPABILITIES: "compute,utility,graphics"
        ODIN_DISPATCH_ID: "{{ dispatch_id }}"
        ODIN_ROW_KEY: "{{ row.row_key }}"
      command: ["bash"]
      args: ["/tmp/entry.sh"]
      files:
      - path: /tmp/entry.sh
        contents: |
          set -euxo pipefail
          cd /workspace/isaaclab
          OUT="{{ '{{output}}' }}/{{ row.row_key }}"
          mkdir -p "$OUT"
          set +e
          uv run --frozen {% for extra in row.uv_extras %}--extra {{ extra }} {% endfor %}isaaclab benchmark training --rl_library {{ row.rl_library }} --task {{ row.task_id }} --seed {{ row.seed }}{% if row.num_envs is not none %} --num_envs {{ row.num_envs }}{% endif %}{% if row.max_iterations is not none %} --max_iterations {{ row.max_iterations }}{% endif %} --output_path "$OUT" --benchmark_formatter schema{% if row.physics %} physics={{ row.physics }}{% endif %}{% if row.renderer %} renderer={{ row.renderer }}{% endif %}{% if row.presets %} presets={{ row.presets | join(',') }}{% endif %}{% for override in row.overrides %} {{ override }}{% endfor %}

          rc=$?
          echo "=== odin: training exit_code=$rc ==="

          # The base image is nvidia/cuda plus uv, which manages its own Python:
          # there is no system python3 on PATH. Use the venv interpreter that
          # `uv sync` created at build time.
          PY=/workspace/isaaclab/.venv/bin/python

          CKPT=""
          KEPT=""
          PLAY_RC=""
          PLAY_STATUS="not_requested"

          # Resolve the checkpoint regardless of what happens next: retaining it
          # and rolling it out are separate concerns.
          if [ "$rc" -eq 0 ]; then
            CKPT=$("$PY" - "$OUT" <<'PYEOF'
          import glob, json, os, sys
          candidates = sorted(glob.glob(os.path.join(sys.argv[1], "benchmark_training_*.json")))
          for path in reversed(candidates):
              try:
                  payload = json.load(open(path))
              except (OSError, ValueError):
                  continue
              checkpoint = payload.get("checkpoint_path")
              if checkpoint:
                  print(checkpoint)
                  break
          PYEOF
          )
          fi
{% if row.keep_checkpoint %}
          # RL libraries write checkpoints under logs/, which OSMO does not
          # upload: only {{ '{{output}}' }} is collected. Without this copy the
          # checkpoint dies with the container and the run is un-replayable.
          if [ -n "$CKPT" ] && [ -f "$CKPT" ]; then
            mkdir -p "$OUT/checkpoint"
            if cp "$CKPT" "$OUT/checkpoint/"; then
              KEPT="checkpoint/$(basename "$CKPT")"
            else
              echo "=== odin: could not copy checkpoint ==="
            fi
          fi
{% endif %}
{% if row.play %}
          # Play is chained in the same task so it can read the checkpoint
          # training just wrote, with no cross-task handoff. It is skipped when
          # training failed: there is nothing to roll out, and a play error
          # would otherwise mask the real verdict.
          if [ "$rc" -ne 0 ]; then
            PLAY_STATUS="skipped_training_failed"
          elif [ -z "$CKPT" ]; then
            PLAY_STATUS="skipped_no_checkpoint"
          else
            echo "=== odin: play from $CKPT ==="
            uv run --frozen {% for extra in row.uv_extras %}--extra {{ extra }} {% endfor %}isaaclab benchmark play --rl_library {{ row.rl_library }} --task {{ row.task_id }} --seed {{ row.seed }} --checkpoint "$CKPT"{% if row.num_envs is not none %} --num_envs {{ row.num_envs }}{% endif %} --output_path "$OUT" --benchmark_formatter schema --video --video_length {{ row.video_length }}{% if row.physics %} physics={{ row.physics }}{% endif %}{% if row.renderer %} renderer={{ row.renderer }}{% endif %}{% if row.presets %} presets={{ row.presets | join(',') }}{% endif %}{% for override in row.overrides %} {{ override }}{% endfor %}

            PLAY_RC=$?
            PLAY_STATUS="ran"
            echo "=== odin: play exit_code=$PLAY_RC ==="
          fi
{% endif %}
          # A per-row record of which steps ran and why any did not. The bundles
          # say what a run measured; this says what happened, which is what you
          # need when a row comes back with less than expected.
          "$PY" - "$OUT" "$rc" "$PLAY_STATUS" "$PLAY_RC" "$CKPT" "$KEPT" <<'PYEOF' || echo "=== odin: could not write odin-steps.json ==="
          import json, os, sys
          out, rc, play_status, play_rc, checkpoint, kept = sys.argv[1:7]
          record = {
              "row_key": os.environ.get("ODIN_ROW_KEY", ""),
              "dispatch_id": os.environ.get("ODIN_DISPATCH_ID", ""),
              "training": {"ran": True, "exit_code": int(rc)},
              "checkpoint": {
                  "found": bool(checkpoint),
                  "source_path": checkpoint or None,
                  "retained_as": kept or None,
              },
              "play": {
                  "status": play_status,
                  "exit_code": int(play_rc) if play_rc else None,
              },
              "artifacts": sorted(
                  os.path.relpath(os.path.join(root, name), out)
                  for root, _dirs, files in os.walk(out)
                  for name in files
              )[:200],
          }
          with open(os.path.join(out, "odin-steps.json"), "w") as handle:
              json.dump(record, handle, indent=2)
          print("=== odin: steps ===")
          print(json.dumps({k: v for k, v in record.items() if k != "artifacts"}, indent=2))
          PYEOF

          set -e
          # `head` closes the pipe early, so `find` dies of SIGPIPE and the
          # pipeline exits 141. Under `set -o pipefail` that would end the
          # script before it could exit with the training verdict.
          find "$OUT" -type f | head -40 || true
          # A training failure is the verdict when there is one.
          [ "$rc" -ne 0 ] && exit $rc
          # Play was requested and failed: the row produced no video, so it is
          # not a success. Exit 90 rather than $PLAY_RC so the poller can tell
          # "trained fine, no video" from a training crash -- the two triage
          # differently and only the former leaves a usable checkpoint.
          [ "$PLAY_STATUS" = "ran" ] && [ "$PLAY_RC" -ne 0 ] && exit 90
          exit 0
      # OSMO uploads {{ '{{output}}' }} itself, after exec and regardless of exit
      # code, so a crashed run still returns what it produced and no publishing
      # step can mask the benchmark's verdict. Each task writes into its own
      # {{ '{{output}}' }}/<row_key>/, so uploads never collide under this shared prefix.
      outputs:
      - url: {{ output_uri }}
{% if cfg.retry.reschedule_codes or cfg.retry.restart_codes %}
      exitActions:
{% if cfg.retry.reschedule_codes %}
        RESCHEDULE: {{ cfg.retry.reschedule_codes }}
{% endif %}
{% if cfg.retry.restart_codes %}
        RESTART: {{ cfg.retry.restart_codes }}
{% endif %}
{% endif %}
{% endfor %}
