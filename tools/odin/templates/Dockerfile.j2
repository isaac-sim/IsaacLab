# Generated by tools/odin/image.py. Do not edit by hand.
FROM {{ cuda_image }}

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_CACHE_DIR=/opt/uv-cache
ENV PATH=/root/.local/bin:$PATH

# libgl1/libegl1 provide the GL loader Newton's headless video recorder reaches
# through pyglet. The CUDA runtime image ships no libGL at all, so without them
# play fails with `Library "GL" not found`, surfaced as "requires pyglet to be
# installed" even though pyglet is present. The NVIDIA driver's own GL is
# injected at run time and needs the graphics capability, set in dispatch.yaml.j2.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        libgl1 libegl1 \
    && rm -rf /var/lib/apt/lists/*

# uv manages its own Python (pyproject sets python-preference = "only-managed"),
# so the base image needs no interpreter.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Clone from a bundle rather than copying a checkout: capture_versions() records
# git_commit, git_branch, and git_dirty, so the image needs a real .git or every
# emitted benchmark bundle loses its provenance. A bundle also works for commits
# that were never pushed.
COPY isaaclab.bundle /tmp/isaaclab.bundle
RUN git clone --branch {{ bundle_ref }} /tmp/isaaclab.bundle /workspace/isaaclab \
    && rm /tmp/isaaclab.bundle

WORKDIR /workspace/isaaclab

# Fail loudly if the bundle did not carry the commit under test.
RUN test "$(git rev-parse HEAD)" = "{{ commit_sha }}"

# uv sync resolves against this commit's committed uv.lock, so a commit that
# changes a dependency is tested with the changed dependency.
#
# The download cache is a BuildKit cache mount, not an image layer. This step
# pulls tens of GB from PyPI, and on a flaky link a drop partway through would
# otherwise discard everything and restart from zero -- the mount makes a retry
# resume from what already landed. It also keeps the cache out of the image.
#
# Nothing needs the cache at run time: the venv built here already matches what
# tasks request, and `uv run --frozen` cannot re-resolve, so a task with the
# same extras never reaches the network.
#
# UV_HTTP_TIMEOUT is raised well above the 30s default because large wheels
# behind a VPN routinely stall longer than that without the transfer being dead.
ENV UV_HTTP_TIMEOUT=180

RUN --mount=type=cache,target=/opt/uv-cache,sharing=locked \
    uv sync --frozen --extra {{ uv_extras | join(" --extra ") }}
