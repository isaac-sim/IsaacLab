# Generated by tools/odin/image.py. Do not edit by hand.
FROM {{ cuda_image }}

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_CACHE_DIR=/opt/uv-cache
ENV PATH=/root/.local/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

# uv manages its own Python (pyproject sets python-preference = "only-managed"),
# so the base image needs no interpreter.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Clone from a bundle rather than copying a checkout: capture_versions() records
# git_commit, git_branch, and git_dirty, so the image needs a real .git or every
# emitted benchmark bundle loses its provenance. A bundle also works for commits
# that were never pushed.
COPY isaaclab.bundle /tmp/isaaclab.bundle
RUN git clone --branch {{ bundle_ref }} /tmp/isaaclab.bundle /workspace/isaaclab \
    && rm /tmp/isaaclab.bundle

WORKDIR /workspace/isaaclab

# Fail loudly if the bundle did not carry the commit under test.
RUN test "$(git rev-parse HEAD)" = "{{ commit_sha }}"

# uv sync resolves against this commit's committed uv.lock, so a commit that
# changes a dependency is tested with the changed dependency. Each profile warms
# UV_CACHE_DIR; at task time `uv run --frozen --extra ...` re-syncs from that
# cache without touching the network.
{% for profile in profiles %}
RUN uv sync --frozen {% for extra in profile_extras[profile] %}--extra {{ extra }} {% endfor %}
{% endfor %}
