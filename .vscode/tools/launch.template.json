{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            // Use the interpreter recorded by `isaaclab --editor`; VS Code skips wrapper scripts such as python.sh
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        // Attach to listening debugpy
        // Usage (VSCode but should be similar for other IDEs):
        // 1. Set your breakpoints
        // 2. Run your code under debugpy like so:
        //    uv run python -m debugpy --listen 3000 --wait-for-client -c "from isaaclab.cli import cli; cli()" [cli_args]
        // 3. Select this "Python: Debugger Attach" configuration and press green play button or F5
        {
            "name": "Python: Debugger Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 3000
            }
        },
        {
            "name": "Python: Train Environment",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "isaaclab",
            "args": ["train", "--rl_library", "rsl_rl", "--task", "Isaac-Reach-Franka"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Play Environment",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "isaaclab",
            "args": ["play", "--rl_library", "rsl_rl", "--task", "Isaac-Reach-Franka", "--num_envs", "32"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: SinglePytest",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "pytest",
            "args": [
              "${file}"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: ALL Pytest",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "module": "pytest",
            "args": ["source/isaaclab/test"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
