# CloudXR profile for STANDALONE (headless, no XR client) IsaacTeleop.
#
# This is the default profile teleop scripts pass when run WITHOUT --xr, i.e.
# when IsaacTeleop is used purely as an input/output transport (e.g. an SO-101
# leader arm streaming joint angles) and creates its own OpenXR session instead
# of sourcing handles from Kit's XR bridge.
#
# Workaround being documented here:
#   A CloudXR runtime with no client connected advertises no HMD, so xrGetSystem
#   returns XR_ERROR_FORM_FACTOR_UNAVAILABLE (-35) and the standalone OpenXR
#   session fails to start. Forcing an emulated Quest 3 device profile makes the
#   runtime report an OpenXR system with no client attached, so the session
#   comes up headless. This is a stopgap until CloudXR exposes a first-class
#   clientless/headless form factor; revisit when that lands.
#
# Mirrors avp-cloudxr.env / cloudxrjs-cloudxr.env (both target a live client) but
# for the no-client case. Comments (#) and blank lines are ignored by the CloudXR
# env parser; use full-line comments only (inline "KEY=value # note" is not
# stripped).

# Emulate a Quest 3 headset so an OpenXR system / form factor is available with
# no client connected. This is the line that works around the -35 error.
NV_DEVICE_PROFILE=quest3

# No remote client pushes camera/controller data in standalone mode. Device
# plugins (e.g. so101_leader) push their own tensor data via their own runtime
# environment, independent of this setting.
NV_CXR_ENABLE_PUSH_DEVICES=0

# Do not block waiting for HMD poses that never arrive in a headless session.
NV_ENABLE_POSE_WAIT=0
