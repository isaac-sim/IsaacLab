#usda 1.0

over "MiniPc001"
{
    over "Looks"
    {
        over "M_MiniPc001_001"
        {
            over "Shader"
            {
                float inputs:albedo_brightness = 3.4
                float inputs:metallic_constant = 0.15
                float inputs:metallic_texture_influence = 0
                float inputs:reflection_roughness_constant = 0.55
                float inputs:reflection_roughness_texture_influence = 0
            }
        }
    }
}

over "ProtectiveBox001"
{
