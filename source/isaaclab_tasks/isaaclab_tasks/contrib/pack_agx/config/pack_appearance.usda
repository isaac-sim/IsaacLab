            {
                float inputs:albedo_brightness = 2.6
                float inputs:metallic_constant = 0.05
                float inputs:metallic_texture_influence = 0
                float inputs:reflection_roughness_constant = 0.85
                float inputs:reflection_roughness_texture_influence = 0
