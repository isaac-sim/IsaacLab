mdl 1.7;

import ::math::*;
import ::scene::*;
import ::OmniSurface::OmniSurfaceBase::*;

// Match the shared display-colour endpoints. The tracer changes absorption,
// while the surface remains a refracting liquid with no diffuse scattering.
export material CoffeeWater() = let {
    color local_color = scene::data_lookup_color("displayColor", color(0.66, 0.83, 0.88));
    float clear_luminance = math::luminance(color(0.66, 0.83, 0.88));
    float brew_luminance = math::luminance(color(0.12, 0.041, 0.014));
    float concentration = math::clamp(
        (clear_luminance - math::luminance(local_color)) / (clear_luminance - brew_luminance), 0.0, 1.0);
    color transmission = math::lerp(color(0.995, 0.998, 1.0), color(0.42, 0.16, 0.045), concentration);
} in ::OmniSurface::OmniSurfaceBase::OmniSurfaceBase(
    diffuse_reflection_weight: 0.0,
    specular_reflection_roughness: 0.015,
    specular_reflection_ior: 1.333,
    enable_specular_transmission: true,
    specular_transmission_weight: 1.0,
    specular_transmission_color: transmission,
    specular_transmission_scattering_depth: 0.04,
    specular_transmission_scattering_color: color(0.0),
    thin_walled: false
);
