###
# Kit-less settings
###

# Ubuntu base image for the standalone kit-less container
KITLESS_BASE_IMAGE=ubuntu:24.04
# The Isaac Lab path in the container
DOCKER_ISAACLAB_PATH=/workspace/isaaclab
# Kit-less runtime user directory
DOCKER_USER_HOME=/home/isaaclab
# Docker image and container name suffix (default "", set by container_interface.py)
# Example: "-custom"
DOCKER_NAME_SUFFIX=""
