# Conda-enabled layer for installation CI tests.
# Builds on top of the uv-based installci image.
#
# Usage:
#   # First build the base uv image
#   docker build --build-arg BASE_IMAGE=ubuntu:24.04 \
#     -f docker/Dockerfile.installci -t isaaclab-installci:uv .
#   # Then build this conda layer on top
#   docker build --build-arg UV_IMAGE=isaaclab-installci:uv \
#     -f docker/Dockerfile.installci-conda -t isaaclab-installci:conda .
#   docker run --rm --gpus all isaaclab-installci:conda -v -m conda

ARG UV_IMAGE=isaaclab-installci:uv
FROM ${UV_IMAGE}

SHELL ["/bin/bash", "-c"]

# Install Miniconda
ARG MINICONDA_VERSION=latest
RUN curl -fsSL "https://repo.anaconda.com/miniconda/Miniconda3-${MINICONDA_VERSION}-Linux-x86_64.sh" \
      -o /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh

ENV PATH="/opt/conda/bin:${PATH}"

# Ensure conda is initialised for non-interactive bash
RUN conda init bash && \
    echo "conda activate base" >> ~/.bashrc

# Smoke-test: conda should be functional
RUN conda --version && python --version
