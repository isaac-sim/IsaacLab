# Kitless Newton image for GPU-accelerated headless training without Isaac Sim.
ARG BASE_IMAGE_ARG=ubuntu:24.04

FROM ${BASE_IMAGE_ARG} AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG ISAACLAB_PATH_ARG=/workspace/isaaclab
ENV ISAACLAB_PATH=${ISAACLAB_PATH_ARG}
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV VIRTUAL_ENV=${ISAACLAB_PATH_ARG}/.venv
ENV PATH=${ISAACLAB_PATH_ARG}/.venv/bin:/usr/local/bin:${PATH}
ENV UV_NO_CACHE=1

# Keep this package set aligned with the documented Ubuntu installation path.
# Native build tools remain confined to this stage.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      git \
      libglib2.0-0 \
      python3 \
      python3-dev \
 && rm -rf /var/lib/apt/lists/* \
 && curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR ${ISAACLAB_PATH}

# Copy the install inputs before the rest of the runtime tree so dependency
# installation remains cached when only scripts or application code changes.
COPY isaaclab.sh pyproject.toml VERSION LICENSE LICENSE-mimic README.md ./
COPY source/ source/

# The venv pins the system Python 3.12 (the version documented in the install
# docs) so the interpreter cannot silently drift from the runtime stage's
# libpython3.12 if the base image's default python3 ever changes.
RUN chmod +x isaaclab.sh \
 && uv venv --python /usr/bin/python3.12 --seed "${VIRTUAL_ENV}" \
 && ./isaaclab.sh --install 'newton,rl[rsl-rl]' \
 && python -c "import importlib.metadata as m; assert all(d.metadata['Name'].lower() != 'isaacsim' for d in m.distributions())" \
 && test ! -e "${ISAACLAB_PATH}/_isaac_sim"

# isaaclab.utils.assets parses apps/isaaclab.python.kit at import time to
# resolve the Nucleus asset root, so apps/ is required even without Kit.
COPY apps/ apps/
COPY scripts/ scripts/
COPY docs/licenses/ docs/licenses/


FROM ${BASE_IMAGE_ARG} AS runtime

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG ISAACLAB_PATH_ARG=/workspace/isaaclab
ENV ISAACLAB_PATH=${ISAACLAB_PATH_ARG}
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV HOME=/home/isaaclab
ENV VIRTUAL_ENV=${ISAACLAB_PATH_ARG}/.venv
ENV PATH=${ISAACLAB_PATH_ARG}/.venv/bin:/usr/local/bin:${PATH}
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      libglib2.0-0 \
      libpython3.12 \
      python3 \
 && rm -rf /var/lib/apt/lists/* \
 && if getent passwd ubuntu >/dev/null; then userdel -r ubuntu; fi \
 && if getent group ubuntu >/dev/null; then groupdel ubuntu; fi \
 && groupadd --gid 1000 isaaclab \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash isaaclab

COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /usr/local/bin/uvx /usr/local/bin/uvx
COPY --from=builder --chown=isaaclab:isaaclab ${ISAACLAB_PATH} ${ISAACLAB_PATH}

RUN mkdir -p ${ISAACLAB_PATH}/logs ${HOME}/.cache/uv ${HOME}/.cache/warp \
 && chown -R isaaclab:isaaclab ${ISAACLAB_PATH}/logs ${HOME}

USER isaaclab
WORKDIR ${ISAACLAB_PATH}

CMD ["bash"]
